# Salin file ini menjadi .env.local lalu isi dengan nilai dari proyek Supabase Anda
# (Supabase Dashboard > Project Settings > API). JANGAN commit file .env.local.

# URL proyek Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon / publishable key (aman dipakai di browser, dilindungi oleh RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Opsional: hanya untuk preview v0 agar link konfirmasi email kembali ke aplikasi
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Opsional: hanya untuk menjalankan scripts/test-rls.mjs secara lokal (server-side, JANGAN pakai prefix NEXT_PUBLIC_)
# POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/postgres

# CATATAN: aplikasi ini TIDAK memakai SUPABASE_SERVICE_ROLE_KEY.
# Seluruh keamanan ditegakkan oleh Row Level Security di database.
